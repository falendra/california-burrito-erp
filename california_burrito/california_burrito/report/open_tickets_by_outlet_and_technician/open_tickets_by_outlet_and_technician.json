 "name": "Open Tickets by Outlet and Technician",
 "owner": "Administrator",
 "query": "SELECT\n\tt.name AS name,\n\tt.outlet AS outlet,\n\tt.asset AS asset,\n\ttx.taxonomy_label AS ticket_taxonomy,\n\tt.priority AS priority,\n\tt.status AS status,\n\tt.assigned_to AS assigned_to,\n\tt.source_pm_execution AS source_pm_execution\nFROM `tabCB Ticket` t\nLEFT JOIN `tabCB Ticket Taxonomy` tx ON tx.name = t.ticket_taxonomy\nWHERE t.status NOT IN ('Resolved', 'Closed', 'Cancelled')\nORDER BY t.outlet ASC, t.assigned_to ASC",
