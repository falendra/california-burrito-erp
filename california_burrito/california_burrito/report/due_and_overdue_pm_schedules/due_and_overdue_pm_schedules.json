 "name": "Due and Overdue PM Schedules",
 "owner": "Administrator",
 "query": "SELECT\n\ts.name AS name,\n\ts.outlet AS outlet,\n\tp.program_name AS pm_program,\n\ts.asset AS asset,\n\ts.due_date AS due_date,\n\ts.status AS status,\n\tDATEDIFF(CURDATE(), s.due_date) AS days_overdue\nFROM `tabCB PM Schedule` s\nLEFT JOIN `tabCB PM Program` p ON p.name = s.pm_program\nWHERE s.status NOT IN ('Completed', 'Cancelled')\n\tAND s.due_date <= CURDATE()\nORDER BY s.due_date ASC",
